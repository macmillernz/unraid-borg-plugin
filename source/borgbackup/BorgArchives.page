<?php
/* Borg Backup - browse archives in the repository and read the run log. */
require_once '/usr/local/emhttp/plugins/borgbackup/include/BorgLib.php';

$s     = borg_settings();
$state = borg_state();
$csrf  = $var['csrf_token'] ?? '';
?>
<link  rel="stylesheet" href="/plugins/borgbackup/images/borg.css">
<script src="/plugins/borgbackup/images/borg.js"></script>
<script>const BORG_CSRF = <?=json_encode($csrf)?>;</script>

<?php if (!$s['REPO']): ?>
  <div class="borg-status warn">
    <span class="borg-dot warn"></span>No repository configured yet &mdash;
    set one on the <a href="/Utilities/Borg">Settings</a> tab.
  </div>
<?php else: ?>

<div class="borg-status info">
  <span class="borg-dot info"></span>
  Repository: <code><?=borg_h($s['REPO'])?></code>
  <?php if ($state['LAST_RUN']): ?>
    <div class="borg-last">Last run <?=borg_h($state['LAST_RUN'])?> &mdash;
      <span class="borg-result <?=borg_h($state['LAST_RESULT'])?>"><?=borg_h($state['LAST_RESULT'])?></span></div>
  <?php endif; ?>
</div>

<div class="title"><span class="left">Archives</span></div>
<div class="borg-toolbar">
  <button type="button" id="borg-load-archives" class="borg-primary">Load archives</button>
  <button type="button" id="borg-repo-info">Repository size</button>
  <span class="borg-hint">Listing a large or remote repository can take a while.</span>
</div>
<div id="borg-archives"></div>

<div class="title"><span class="left">Log</span></div>
<div class="borg-toolbar">
  <button type="button" id="borg-load-log" class="borg-primary">Refresh log</button>
  <label class="borg-inline"><input type="checkbox" id="borg-follow"> auto-refresh while a backup is running</label>
</div>
<pre id="borg-log" class="borg-output borg-log">Press <em>Refresh log</em> to load /var/log/borgbackup.log</pre>

<blockquote class="inline_help">
To restore, use borg directly over SSH or from the Unraid terminal &mdash; restoring is
deliberately not automated here, because overwriting live data is not something a web
button should make easy:<br>
<code>borg list ::ARCHIVE</code> to see what is in an archive, then
<code>borg extract --strip-components N ::ARCHIVE path/to/thing</code> from the directory
you want it written into. Run <code>export BORG_REPO=...</code> and
<code>export BORG_PASSPHRASE=...</code> first, or borg will prompt.
</blockquote>

<pre id="borg-output" class="borg-output" hidden></pre>
<?php endif; ?>
